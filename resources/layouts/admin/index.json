{
  "version": "1.0.0",
  "layout_name": "admin/index",
  "permissions": ["glitter-reservation_popup.events.view"],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:glitter-reservation_popup.admin.title",
    "description": "$t:glitter-reservation_popup.admin.description"
  },
  "globalHeaders": [
    {"pattern": "/api/modules/glitter-reservation_popup/*", "headers": {"Accept": "application/json"}}
  ],
  "data_sources": [
    {"id": "events", "type": "api", "endpoint": "/api/modules/glitter-reservation_popup/admin/events", "method": "GET", "auto_fetch": true, "auth_required": true, "headers": {"Accept": "application/json"}, "params": {"per_page": "100"}, "fallback": {"data": {"data": [], "meta": {"current_page": 1, "last_page": 1, "per_page": 100, "total": 0}}}},
    {"id": "recentReservations", "type": "api", "endpoint": "/api/modules/glitter-reservation_popup/admin/events/{{query.event || 0}}/reservations", "method": "GET", "auto_fetch": true, "auth_required": true, "if": "{{!!query.event}}", "headers": {"Accept": "application/json"}, "params": {"per_page": "10"}, "fallback": {"data": {"data": [], "meta": {"current_page": 1, "last_page": 1, "per_page": 10, "total": 0}}}},
    {"id": "checkins", "type": "api", "endpoint": "/api/modules/glitter-reservation_popup/admin/checkins", "method": "GET", "auto_fetch": true, "auth_required": true, "headers": {"Accept": "application/json"}, "params": {"per_page": "10"}, "fallback": {"data": {"data": [], "meta": {"current_page": 1, "last_page": 1, "per_page": 10, "total": 0}}}}
  ],
  "slots": {"content": [{"type": "basic", "name": "Div", "props": {"className": "p-6 bg-gray-50 dark:bg-gray-900 min-h-screen"}, "children": [
    {"type": "composite", "name": "PageHeader", "props": {"title": "$t:glitter-reservation_popup.admin.title", "description": "$t:glitter-reservation_popup.admin.description"}, "children": [
      {"id": "create_event_button", "type": "basic", "name": "Button", "props": {"className": "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md bg-blue-600 text-white hover:bg-blue-700"}, "actions": [{"type": "click", "handler": "navigate", "params": {"path": "/admin/reservation-popups/events/create", "mergeQuery": false}}], "children": [{"type": "basic", "name": "Icon", "props": {"name": "plus", "className": "w-4 h-4"}}, {"type": "basic", "name": "Span", "text": "$t:glitter-reservation_popup.actions.create_event"}]},
      {"id": "checkins_button", "type": "basic", "name": "Button", "props": {"className": "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200"}, "actions": [{"type": "click", "handler": "navigate", "params": {"path": "/admin/reservation-popups/checkins", "mergeQuery": false}}], "children": [{"type": "basic", "name": "Icon", "props": {"name": "qr-code", "className": "w-4 h-4"}}, {"type": "basic", "name": "Span", "text": "$t:glitter-reservation_popup.actions.checkins"}]}
    ]},
    {"type": "basic", "name": "Div", "props": {"className": "grid grid-cols-1 md:grid-cols-4 gap-4 mb-6"}, "children": [
      {"type": "basic", "name": "Div", "props": {"className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5"}, "children": [{"type": "basic", "name": "Span", "props": {"className": "text-xs text-gray-500 dark:text-gray-400"}, "text": "$t:glitter-reservation_popup.admin.summary.total_events"}, {"type": "basic", "name": "Span", "props": {"className": "block text-2xl font-semibold text-gray-900 dark:text-white"}, "text": "{{events?.data?.data?.length ?? 0}}"}]},
      {"type": "basic", "name": "Div", "props": {"className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5"}, "children": [{"type": "basic", "name": "Span", "props": {"className": "text-xs text-gray-500 dark:text-gray-400"}, "text": "$t:glitter-reservation_popup.admin.summary.active_events"}, {"type": "basic", "name": "Span", "props": {"className": "block text-2xl font-semibold text-gray-900 dark:text-white"}, "text": "{{(events?.data?.data ?? []).filter(event => event.status === 'published').length}}"}]},
      {"type": "basic", "name": "Div", "props": {"className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5"}, "children": [{"type": "basic", "name": "Span", "props": {"className": "text-xs text-gray-500 dark:text-gray-400"}, "text": "$t:glitter-reservation_popup.admin.summary.today_reservations"}, {"type": "basic", "name": "Span", "props": {"className": "block text-2xl font-semibold text-gray-900 dark:text-white"}, "text": "{{recentReservations?.data?.data?.length ?? 0}}"}]},
      {"type": "basic", "name": "Div", "props": {"className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5"}, "children": [{"type": "basic", "name": "Span", "props": {"className": "text-xs text-gray-500 dark:text-gray-400"}, "text": "$t:glitter-reservation_popup.admin.summary.today_checkins"}, {"type": "basic", "name": "Span", "props": {"className": "block text-2xl font-semibold text-gray-900 dark:text-white"}, "text": "{{checkins?.data?.data?.length ?? 0}}"}]}
    ]},
    {"type": "basic", "name": "Div", "props": {"className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5"}, "children": [{"type": "basic", "name": "Span", "props": {"className": "block text-base font-semibold text-gray-900 dark:text-white mb-3"}, "text": "$t:glitter-reservation_popup.admin.summary.recent_reservations"}, {"type": "basic", "name": "Div", "iteration": {"source": "{{recentReservations?.data?.data ?? []}}", "item_var": "reservation", "index_var": "index"}, "props": {"className": "grid grid-cols-1 md:grid-cols-4 gap-3 py-3 border-t border-gray-200 dark:border-gray-700 first:border-t-0"}, "children": [{"type": "basic", "name": "Span", "text": "{{reservation?.reservation_code ?? '-'}}"}, {"type": "basic", "name": "Span", "text": "{{reservation?.applicant?.name ?? reservation?.customer_name ?? '-'}}"}, {"type": "basic", "name": "Span", "text": "{{reservation?.status ?? '-'}}"}, {"type": "basic", "name": "Button", "props": {"className": "text-sm text-blue-600 dark:text-blue-400"}, "actions": [{"type": "click", "handler": "navigate", "params": {"path": "/admin/reservation-popups/reservations/{{reservation?.id}}", "mergeQuery": false}}], "children": [{"type": "basic", "name": "Span", "text": "$t:glitter-reservation_popup.actions.detail"}]}]}]}
  ]}]}
}
