{
  "version": "1.0.0",
  "layout_name": "admin/reservations/show",
  "permissions": [
    "glitter-reservation_popup.reservations.view"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:glitter-reservation_popup.admin.reservations.detail",
    "description": "$t:glitter-reservation_popup.admin.reservations.detail_description"
  },
  "globalHeaders": [
    {
      "pattern": "/api/modules/glitter-reservation_popup/*",
      "headers": {
        "Accept": "application/json"
      }
    }
  ],
  "init_actions": [],
  "data_sources": [
    {
      "id": "reservation",
      "type": "api",
      "endpoint": "/api/modules/glitter-reservation_popup/admin/reservations/{{route.reservation}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "headers": {
        "Accept": "application/json"
      },
      "params": {},
      "fallback": {
        "data": {
          "data": null
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "p-6 bg-gray-50 dark:bg-gray-900 min-h-screen"
        },
        "children": [
          {
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:glitter-reservation_popup.admin.reservations.detail",
              "description": "$t:glitter-reservation_popup.admin.reservations.detail_description"
            },
            "children": [
              {
                "id": "nav_events",
                "type": "basic",
                "name": "Button",
                "props": {
                  "className": "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/admin/reservation-popups/events",
                      "mergeQuery": false
                    }
                  }
                ],
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "calendar",
                      "className": "w-4 h-4"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": ""
                    },
                    "text": "$t:glitter-reservation_popup.actions.events"
                  }
                ]
              },
              {
                "id": "nav_reservations",
                "type": "basic",
                "name": "Button",
                "props": {
                  "className": "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/admin/reservation-popups/reservations",
                      "mergeQuery": false
                    }
                  }
                ],
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "clipboard-list",
                      "className": "w-4 h-4"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": ""
                    },
                    "text": "$t:glitter-reservation_popup.actions.reservations"
                  }
                ]
              },
              {
                "id": "nav_checkins",
                "type": "basic",
                "name": "Button",
                "props": {
                  "className": "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/admin/reservation-popups/checkins",
                      "mergeQuery": false
                    }
                  }
                ],
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "qr-code",
                      "className": "w-4 h-4"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": ""
                    },
                    "text": "$t:glitter-reservation_popup.actions.checkins"
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5"
            },
            "children": [
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "block text-xl font-semibold text-gray-900 dark:text-white"
                },
                "text": "{{reservation?.data?.data?.reservation_code ?? '-'}}"
              },
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "text-sm text-gray-900 dark:text-white"
                },
                "text": "{{reservation?.data?.data?.applicant?.name ?? reservation?.data?.data?.customer_name ?? '-'}}"
              },
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "text-sm text-gray-900 dark:text-white"
                },
                "text": "{{reservation?.data?.data?.status ?? '-'}}"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "flex flex-wrap gap-2 my-4"
            },
            "children": [
              {
                "id": "confirm_reservation",
                "type": "basic",
                "name": "Button",
                "props": {
                  "className": "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md bg-blue-600 text-white hover:bg-blue-700"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/glitter-reservation_popup/admin/reservations/{{route.reservation}}/status",
                    "params": {
                      "method": "PATCH",
                      "headers": {
                        "Accept": "application/json"
                      },
                      "body": {
                        "status": "confirmed"
                      }
                    },
                    "onSuccess": [
                      {
                        "handler": "toast",
                        "params": {
                          "type": "success",
                          "message": "$t:glitter-reservation_popup.messages.updated"
                        }
                      },
                      {
                        "handler": "refetchDataSource",
                        "params": {
                          "dataSourceId": "reservation"
                        }
                      }
                    ],
                    "onError": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "errors": "{{error.errors}}"
                        }
                      },
                      {
                        "handler": "toast",
                        "params": {
                          "type": "error",
                          "message": "$t:glitter-reservation_popup.messages.validation_error"
                        }
                      }
                    ]
                  }
                ],
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "check",
                      "className": "w-4 h-4"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": ""
                    },
                    "text": "$t:glitter-reservation_popup.actions.confirm"
                  }
                ]
              },
              {
                "id": "cancel_reservation_status",
                "type": "basic",
                "name": "Button",
                "props": {
                  "className": "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200"
                },
                "actions": [
                  {
                    "type": "click",
                    "handler": "apiCall",
                    "auth_required": true,
                    "target": "/api/modules/glitter-reservation_popup/admin/reservations/{{route.reservation}}/status",
                    "params": {
                      "method": "PATCH",
                      "headers": {
                        "Accept": "application/json"
                      },
                      "body": {
                        "status": "cancelled"
                      }
                    },
                    "onSuccess": [
                      {
                        "handler": "toast",
                        "params": {
                          "type": "success",
                          "message": "$t:glitter-reservation_popup.messages.updated"
                        }
                      },
                      {
                        "handler": "refetchDataSource",
                        "params": {
                          "dataSourceId": "reservation"
                        }
                      }
                    ],
                    "onError": [
                      {
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "errors": "{{error.errors}}"
                        }
                      },
                      {
                        "handler": "toast",
                        "params": {
                          "type": "error",
                          "message": "$t:glitter-reservation_popup.messages.validation_error"
                        }
                      }
                    ]
                  }
                ],
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "ban",
                      "className": "w-4 h-4"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                      "className": ""
                    },
                    "text": "$t:glitter-reservation_popup.actions.cancel_reservation"
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5"
            },
            "children": [
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "text-sm text-gray-900 dark:text-white"
                },
                "text": "$t:glitter-reservation_popup.admin.reservations.cancellation_info"
              },
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "text-sm text-gray-900 dark:text-white"
                },
                "text": "{{reservation?.data?.data?.cancellation?.cancelled_at ?? '-'}}"
              },
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "text-sm text-gray-900 dark:text-white"
                },
                "text": "$t:glitter-reservation_popup.admin.reservations.checkin_info"
              },
              {
                "type": "basic",
                "name": "Span",
                "props": {
                  "className": "text-sm text-gray-900 dark:text-white"
                },
                "text": "{{reservation?.data?.data?.checkin?.checked_in_at ?? '-'}}"
              }
            ]
          }
        ]
      }
    ]
  }
}
